{
  "name": "summit-website",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "convex:dev": "node scripts/convex-key.mjs development dev",
    "convex:dev:once": "node scripts/convex-key.mjs development dev --once",
    "convex:codegen": "node scripts/convex-key.mjs development codegen",
    "convex:backup:dev": "node scripts/convex-backup.mjs development",
    "convex:backup:prod": "node scripts/convex-backup.mjs production",
    "convex:deploy:prod": "bun run convex:backup:prod && node scripts/convex-key.mjs production deploy",
    "convex:seed:dev": "node scripts/convex-key.mjs development run seed:seedInitialContent",
    "convex:seed:prod": "node scripts/refuse-production-seed.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@convex-dev/better-auth": "^0.12.5",
    "@vercel/analytics": "^2.0.1",
    "better-auth": "~1.6.15",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.42.3",
    "lucide-react": "^1.27.0",
    "motion": "^12.43.0",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "3.8.0",
    "shadcn": "^4.15.0",
    "sonner": "^2.0.7",
    "stripe": "^22.3.2",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
