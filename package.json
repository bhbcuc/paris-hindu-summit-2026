{
  "name": "summit-website",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test:admin-contracts": "bun scripts/admin-record-regression.mjs && bun scripts/admin-select-regression.mjs",
    "convex:dev": "node scripts/convex-key.mjs development dev",
    "convex:dev:once": "node scripts/convex-key.mjs development dev --once",
    "convex:codegen": "node scripts/convex-key.mjs development codegen",
    "convex:backup:dev": "node scripts/convex-backup.mjs development",
    "convex:backup:prod": "node scripts/convex-backup.mjs production",
    "convex:deploy:prod": "bun run convex:backup:prod && node scripts/convex-key.mjs production deploy",
    "convex:seed:dev": "node scripts/convex-key.mjs development run seed:seedInitialContent",
    "convex:seed:prod": "node scripts/refuse-production-seed.mjs",
    "dev:vinext": "vite dev --port 3001",
    "build:vinext": "vite build",
    "start:vinext": "vite preview",
    "deploy:vinext": "vinext-cloudflare deploy",
    "db:migrate:dev": "node scripts/d1-migrate.mjs --target dev --dir db/migrations",
    "db:migrate:guarded": "node scripts/d1-migrate.mjs --target dev --dir db/migrations --guarded",
    "db:fingerprint:dev": "node scripts/d1-fingerprint.mjs --target dev",
    "db:fingerprint:prod": "node scripts/d1-fingerprint.mjs --target prod --allow-production",
    "import:convex:snapshot": "node scripts/import-convex-snapshot.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@better-auth/core": "^1.7.7",
    "@better-auth/expo": "1.6.15",
    "@better-auth/kysely-adapter": "^1.7.7",
    "@convex-dev/better-auth": "^0.12.5",
    "@vinext/cloudflare": "^1.0.1",
    "better-auth": "^1.7.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.42.3",
    "hono": "^4.13.13",
    "kysely": "^0.29.6",
    "lucide-react": "^1.27.0",
    "motion": "^12.43.0",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "nodemailer": "^9.0.3",
    "postal-mime": "^2.7.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-server-dom-webpack": "^19.3.0",
    "recharts": "3.8.0",
    "shadcn": "^4.15.0",
    "sonner": "^2.0.7",
    "stripe": "^23.0.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "vinext": "^1.0.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-beta.sha-52b0dc0e9",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.35",
    "cf": "^1.0.0-beta.12",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "8.3.0",
    "wrangler": "^4.118.0"
  }
}
